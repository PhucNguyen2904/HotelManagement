
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================== ENUMS ========================

enum UserRole {
  SUPER_ADMIN
  HOTEL_ADMIN
  STAFF
  GUEST
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  OUT_OF_ORDER
}

enum AvailabilityStatus {
  AVAILABLE
  BOOKED
  BLOCKED
  MAINTENANCE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  MOMO
  VNPAY
  ZALOPAY
}

enum PricingType {
  BASE
  WEEKEND
  SEASONAL
  HOLIDAY
  PROMOTION
  LAST_MINUTE
}

enum BedType {
  SINGLE
  DOUBLE
  TWIN
  QUEEN
  KING
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

// ======================== MODELS ========================

/// Khách sạn — Multi-hotel ready
model Hotel {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(255)
  slug         String   @unique @db.VarChar(255)
  description  String?  @db.Text
  address      String   @db.VarChar(500)
  city         String   @db.VarChar(100)
  province     String   @db.VarChar(100)
  phone        String   @db.VarChar(20)
  email        String   @db.VarChar(255)
  website      String?  @db.VarChar(255)
  starRating   Int      @default(3) @map("star_rating")
  checkInTime  String   @default("14:00") @map("check_in_time") @db.VarChar(5)
  checkOutTime String   @default("12:00") @map("check_out_time") @db.VarChar(5)
  logoUrl      String?  @map("logo_url") @db.VarChar(500)
  coverUrl     String?  @map("cover_url") @db.VarChar(500)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  roomTypes RoomType[]
  bookings  Booking[]
  taxRates  TaxRate[]
  coupons   Coupon[]
  staff     HotelStaff[]

  @@map("hotels")
}

/// Người dùng — Admin, Staff, Guest
model User {
  id            String    @id @default(cuid())
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  fullName      String    @map("full_name") @db.VarChar(255)
  phone         String?   @db.VarChar(20)
  idNumber      String?   @map("id_number") @db.VarChar(50)
  address       String?   @db.VarChar(500)
  avatarUrl     String?   @map("avatar_url") @db.VarChar(500)
  role          UserRole  @default(GUEST)
  isActive      Boolean   @default(true) @map("is_active")
  emailVerified Boolean   @default(false) @map("email_verified")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  bookings   Booking[]
  reviews    Review[]
  hotelStaff HotelStaff[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@map("users")
}

/// Phân quyền staff cho hotel (N:N user ↔ hotel)
model HotelStaff {
  id      String   @id @default(cuid())
  userId  String   @map("user_id")
  hotelId String   @map("hotel_id")
  role    UserRole @default(STAFF)

  user  User  @relation(fields: [userId], references: [id])
  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@unique([userId, hotelId])
  @@map("hotel_staff")
}

/// Loại phòng — Single, Twin, Double, Suite...
/// bedType: Loại giường (SINGLE, DOUBLE, TWIN, QUEEN, KING)
/// bedCount: Số lượng giường trong phòng
/// capacity: maxAdults (số người tối đa = maxAdults + maxChildren)
model RoomType {
  id          String   @id @default(cuid())
  hotelId     String   @map("hotel_id")
  name        String   @db.VarChar(255)
  slug        String   @db.VarChar(255)
  description String?  @db.Text
  basePrice   Decimal  @map("base_price") @db.Decimal(12, 0)
  maxAdults   Int      @default(2) @map("max_adults")
  maxChildren Int      @default(1) @map("max_children")
  maxInfants  Int      @default(1) @map("max_infants")
  bedType     BedType  @default(DOUBLE) @map("bed_type")
  bedCount    Int      @default(1) @map("bed_count")
  areaSize    Float?   @map("area_size")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  hotel     Hotel             @relation(fields: [hotelId], references: [id])
  rooms     Room[]
  images    RoomImage[]
  amenities RoomTypeAmenity[]
  pricing   PricingRule[]
  reviews   Review[]

  @@unique([hotelId, slug])
  @@index([hotelId])
  @@index([basePrice])
  @@map("room_types")
}

/// Phòng vật lý — mỗi phòng có số phòng cụ thể
model Room {
  id         String     @id @default(cuid())
  roomTypeId String     @map("room_type_id")
  roomNumber String     @map("room_number") @db.VarChar(20)
  floor      Int        @default(1)
  status     RoomStatus @default(AVAILABLE)
  notes      String?    @db.Text
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  roomType     RoomType          @relation(fields: [roomTypeId], references: [id])
  availability RoomAvailability[]
  bookingRooms BookingRoom[]

  @@unique([roomTypeId, roomNumber])
  @@index([roomTypeId])
  @@index([status])
  @@map("rooms")
}

/// Tiện nghi — WiFi, AC, Minibar...
model RoomAmenity {
  id       String  @id @default(cuid())
  name     String  @unique @db.VarChar(100)
  icon     String? @db.VarChar(50)
  category String? @db.VarChar(50)

  roomTypes RoomTypeAmenity[]

  @@map("room_amenities")
}

/// N:N — RoomType ↔ Amenity
model RoomTypeAmenity {
  roomTypeId String @map("room_type_id")
  amenityId  String @map("amenity_id")

  roomType RoomType    @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  amenity  RoomAmenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([roomTypeId, amenityId])
  @@map("room_type_amenities")
}

/// Ảnh phòng
model RoomImage {
  id         String  @id @default(cuid())
  roomTypeId String  @map("room_type_id")
  url        String  @db.VarChar(500)
  alt        String? @db.VarChar(255)
  sortOrder  Int     @default(0) @map("sort_order")
  isPrimary  Boolean @default(false) @map("is_primary")

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([roomTypeId])
  @@map("room_images")
}

/// Rule giá — base, weekend, seasonal, holiday, promotion
model PricingRule {
  id         String      @id @default(cuid())
  roomTypeId String      @map("room_type_id")
  name       String      @db.VarChar(255)
  type       PricingType @default(BASE)
  price      Decimal     @db.Decimal(12, 0)
  startDate  DateTime?   @map("start_date") @db.Date
  endDate    DateTime?   @map("end_date") @db.Date
  daysOfWeek Int[]       @map("days_of_week")
  priority   Int         @default(0)
  isActive   Boolean     @default(true) @map("is_active")
  createdAt  DateTime    @default(now()) @map("created_at")

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([roomTypeId, type])
  @@index([startDate, endDate])
  @@index([priority])
  @@map("pricing_rules")
}

/// Lịch phòng trống — 1 row = 1 phòng + 1 ngày
model RoomAvailability {
  id        String             @id @default(cuid())
  roomId    String             @map("room_id")
  date      DateTime           @db.Date
  status    AvailabilityStatus @default(AVAILABLE)
  bookingId String?            @map("booking_id")
  price     Decimal?           @db.Decimal(12, 0)
  notes     String?            @db.VarChar(255)

  room    Room     @relation(fields: [roomId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@unique([roomId, date]) // CRITICAL: Chống overbooking ở DB level
  @@index([date, status])
  @@index([roomId, date])
  @@index([bookingId])
  @@map("room_availability")
}

/// Đơn đặt phòng
model Booking {
  id             String        @id @default(cuid())
  bookingCode    String        @unique @map("booking_code") @db.VarChar(20)
  userId         String        @map("user_id")
  hotelId        String        @map("hotel_id")
  status         BookingStatus @default(PENDING)
  checkIn        DateTime      @map("check_in") @db.Date
  checkOut       DateTime      @map("check_out") @db.Date
  totalNights    Int           @map("total_nights")
  adults         Int           @default(1)
  children       Int           @default(0)
  infants        Int           @default(0)
  subtotal       Decimal       @db.Decimal(12, 0)
  taxRate        Decimal       @default(10) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount      Decimal       @map("tax_amount") @db.Decimal(12, 0)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 0)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(12, 0)

  // Guest info (có thể khác user — đặt hộ)
  guestName    String? @map("guest_name") @db.VarChar(255)
  guestEmail   String? @map("guest_email") @db.VarChar(255)
  guestPhone   String? @map("guest_phone") @db.VarChar(20)
  guestIdNumber String? @map("guest_id_number") @db.VarChar(50)

  specialRequests String?   @map("special_requests") @db.Text
  internalNotes   String?   @map("internal_notes") @db.Text
  cancelReason    String?   @map("cancel_reason") @db.VarChar(500)
  cancelledAt     DateTime? @map("cancelled_at")
  confirmedAt     DateTime? @map("confirmed_at")
  checkedInAt     DateTime? @map("checked_in_at")
  checkedOutAt    DateTime? @map("checked_out_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user         User               @relation(fields: [userId], references: [id])
  hotel        Hotel              @relation(fields: [hotelId], references: [id])
  bookingRooms BookingRoom[]
  payments     Payment[]
  review       Review?
  availability RoomAvailability[]
  couponUsages BookingCoupon[]

  @@index([userId])
  @@index([hotelId])
  @@index([status])
  @@index([checkIn, checkOut])
  @@index([createdAt])
  @@index([bookingCode])
  @@map("bookings")
}

/// Chi tiết phòng trong booking (multi-room support)
model BookingRoom {
  id            String   @id @default(cuid())
  bookingId     String   @map("booking_id")
  roomId        String   @map("room_id")
  checkIn       DateTime @map("check_in") @db.Date
  checkOut      DateTime @map("check_out") @db.Date
  pricePerNight Decimal  @map("price_per_night") @db.Decimal(12, 0)
  totalPrice    Decimal  @map("total_price") @db.Decimal(12, 0)
  adults        Int      @default(1)
  children      Int      @default(0)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room    Room    @relation(fields: [roomId], references: [id])

  @@unique([bookingId, roomId])
  @@index([bookingId])
  @@index([roomId])
  @@map("booking_rooms")
}

/// Thanh toán
model Payment {
  id             String        @id @default(cuid())
  bookingId      String        @map("booking_id")
  amount         Decimal       @db.Decimal(12, 0)
  method         PaymentMethod @default(CASH)
  status         PaymentStatus @default(PENDING)
  transactionRef String?       @map("transaction_ref") @db.VarChar(255)
  paidAt         DateTime?     @map("paid_at")
  refundedAt     DateTime?     @map("refunded_at")
  refundAmount   Decimal?      @map("refund_amount") @db.Decimal(12, 0)
  notes          String?       @db.Text
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([status])
  @@index([transactionRef])
  @@map("payments")
}

/// Thuế suất
model TaxRate {
  id        String   @id @default(cuid())
  hotelId   String   @map("hotel_id")
  name      String   @db.VarChar(100)
  rate      Decimal  @db.Decimal(5, 2)
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@index([hotelId])
  @@map("tax_rates")
}

/// Đánh giá
model Review {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  bookingId   String    @unique @map("booking_id")
  roomTypeId  String    @map("room_type_id")
  rating      Int // 1–5
  title       String?   @db.VarChar(255)
  comment     String?   @db.Text
  isVisible   Boolean   @default(true) @map("is_visible")
  response    String?   @db.Text
  respondedAt DateTime? @map("responded_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id])
  booking  Booking  @relation(fields: [bookingId], references: [id])
  roomType RoomType @relation(fields: [roomTypeId], references: [id])

  @@index([roomTypeId, rating])
  @@index([userId])
  @@map("reviews")
}

/// Mã giảm giá
model Coupon {
  id              String     @id @default(cuid())
  hotelId         String     @map("hotel_id")
  code            String     @db.VarChar(50)
  name            String     @db.VarChar(255)
  type            CouponType @default(PERCENTAGE)
  value           Decimal    @db.Decimal(12, 2)
  minNights       Int?       @map("min_nights")
  minAmount       Decimal?   @map("min_amount") @db.Decimal(12, 0)
  maxDiscount     Decimal?   @map("max_discount") @db.Decimal(12, 0)
  maxUsage        Int?       @map("max_usage")
  usedCount       Int        @default(0) @map("used_count")
  maxUsagePerUser Int?       @map("max_usage_per_user")
  startDate       DateTime   @map("start_date") @db.Date
  endDate         DateTime   @map("end_date") @db.Date
  isActive        Boolean    @default(true) @map("is_active")
  createdAt       DateTime   @default(now()) @map("created_at")

  hotel    Hotel           @relation(fields: [hotelId], references: [id])
  bookings BookingCoupon[]

  @@unique([hotelId, code])
  @@index([code])
  @@index([startDate, endDate])
  @@map("coupons")
}

/// N:N — Booking ↔ Coupon
model BookingCoupon {
  bookingId      String  @map("booking_id")
  couponId       String  @map("coupon_id")
  discountAmount Decimal @map("discount_amount") @db.Decimal(12, 0)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  coupon  Coupon  @relation(fields: [couponId], references: [id])

  @@id([bookingId, couponId])
  @@map("booking_coupons")
}
