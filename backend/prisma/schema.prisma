generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Khách sạn — Multi-hotel ready
model Hotel {
  id           String    @id @default(cuid())
  name         String    @db.VarChar(255)
  slug         String    @unique @db.VarChar(255)
  description  String?
  address      String?   @db.VarChar(500)
  city         String?   @db.VarChar(100)
  province     String?   @db.VarChar(100)
  phone        String?   @db.VarChar(20)
  email        String?   @db.VarChar(255)
  website      String?   @db.VarChar(255)
  starRating   Int?      @default(3) @map("star_rating")
  checkInTime  String?   @default("14:00") @map("check_in_time") @db.VarChar(5)
  checkOutTime String?   @default("12:00") @map("check_out_time") @db.VarChar(5)
  isActive     Boolean?  @default(true) @map("is_active")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(3)

  roomTypes    RoomType[]
  bookings     Booking[]
  reviews      Review[]

  @@map("hotels")
}

/// Người dùng — Admin, Staff, Guest
model User {
  id                String     @id @default(cuid())
  email             String     @unique @db.VarChar(255)
  passwordHash      String     @map("password_hash") @db.VarChar(255)
  fullName          String     @map("full_name") @db.VarChar(255)
  phone             String?    @db.VarChar(20)
  idNumber          String?    @map("id_number") @db.VarChar(50)
  address           String?    @db.VarChar(500)
  avatarUrl         String?    @map("avatar_url") @db.VarChar(500)
  role              user_role? @default(GUEST)
  isActive          Boolean?   @default(true) @map("is_active")
  emailVerified     Boolean?   @default(false) @map("email_verified")
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamp(3)
  createdAt         DateTime?  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt         DateTime?  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(3)

  bookings          Booking[]
  reviews           Review[]

  @@index([email], map: "idx_users_email")
  @@index([role], map: "idx_users_role")
  @@map("users")
}

/// Loại phòng — Single, Twin, Double, Suite...
model RoomType {
  id            String    @id @default(cuid())
  hotelId       String    @map("hotel_id")
  name          String    @db.VarChar(255)
  slug          String    @db.VarChar(255)
  description   String?
  basePrice     Decimal   @map("base_price") @db.Decimal(12, 0)
  maxAdults     Int?      @default(2) @map("max_adults")
  maxChildren   Int?      @default(1) @map("max_children")
  maxInfants    Int?      @default(1) @map("max_infants")
  bedType       bed_type? @default(DOUBLE) @map("bed_type")
  bedCount      Int?      @default(1) @map("bed_count")
  areaSize      Float?    @map("area_size")
  isActive      Boolean?  @default(true) @map("is_active")
  sortOrder     Int?      @default(0) @map("sort_order")
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt     DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(3)

  hotel         Hotel?                  @relation(fields: [hotelId], references: [id])
  rooms         Room[]
  pricing       PricingRule[]
  reviews       Review[]
  images        room_type_images[]
  amenities     room_type_amenity[]

  @@unique([hotelId, slug])
  @@index([hotelId], map: "idx_room_types_hotel")
  @@map("room_types")
}

/// Phòng vật lý — mỗi phòng có số phòng cụ thể
model Room {
  id         String       @id @default(cuid())
  roomTypeId String       @map("room_type_id")
  roomNumber String       @map("room_number") @db.VarChar(20)
  floor      Int?         @default(1)
  status     room_status? @default(AVAILABLE)
  notes      String?
  isActive   Boolean?     @default(true) @map("is_active")
  createdAt  DateTime?    @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt  DateTime?    @default(now()) @updatedAt @map("updated_at") @db.Timestamp(3)

  roomType      RoomType?       @relation(fields: [roomTypeId], references: [id])
  bookingRooms  BookingRoom[]

  @@unique([roomTypeId, roomNumber])
  @@index([status], map: "idx_rooms_status")
  @@index([roomTypeId], map: "idx_rooms_type")
  @@map("rooms")
}

/// Rule giá — base, weekend, seasonal, holiday, promotion
model PricingRule {
  id                    String       @id @default(cuid())
  roomTypeId            String       @map("room_type_id") @db.VarChar(25)
  name                  String       @db.VarChar(255)
  type                  pricing_type
  price                 Decimal      @db.Decimal(12, 0)
  percentage_adjustment Decimal?     @db.Decimal(5, 2)
  startDate             DateTime?    @map("start_date") @db.Date
  endDate               DateTime?    @map("end_date") @db.Date
  daysOfWeek            Int[]        @default([]) @map("days_of_week")
  priority              Int?         @default(0)
  isActive              Boolean?     @default(true) @map("is_active")
  createdAt             DateTime?    @default(now()) @map("created_at") @db.Timestamp(6)
  updated_at            DateTime?    @default(now()) @db.Timestamp(6)

  roomType              RoomType?    @relation(fields: [roomTypeId], references: [id])

  @@index([startDate, endDate], map: "idx_pricing_rules_dates")
  @@map("pricing_rules")
}

/// Lịch phòng trống — 1 row = 1 phòng + 1 ngày
model RoomAvailability {
  id         String               @id @default(cuid())
  roomId     String               @map("room_id") @db.VarChar(25)
  date       DateTime             @db.Date
  status     availability_status? @default(AVAILABLE)
  bookingId  String?              @map("booking_id") @db.VarChar(25)
  price      Decimal?             @db.Decimal(12, 0)
  notes      String?
  created_at DateTime?            @default(now()) @db.Timestamp(3)
  updated_at DateTime?            @default(now()) @db.Timestamp(3)

  @@unique([roomId, date])
  @@index([date, status], map: "idx_room_availability_date_status")
  @@index([roomId, date], map: "idx_room_availability_room_date")
  @@map("room_availability")
}

/// Đơn đặt phòng
model Booking {
  id                  String          @id @default(cuid())
  bookingCode         String          @unique @map("booking_code") @db.VarChar(20)
  userId              String          @map("user_id") @db.VarChar(25)
  hotelId             String          @map("hotel_id") @db.VarChar(25)
  status              booking_status? @default(PENDING)
  checkIn             DateTime        @map("check_in") @db.Date
  checkOut            DateTime        @map("check_out") @db.Date
  totalNights         Int             @map("total_nights")
  adults              Int?            @default(1)
  children            Int?            @default(0)
  infants             Int?            @default(0)
  subtotal            Decimal?        @default(0) @db.Decimal(12, 0)
  taxRate             Decimal?        @default(10.00) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount           Decimal?        @default(0) @map("tax_amount") @db.Decimal(12, 0)
  discountAmount      Decimal?        @default(0) @map("discount_amount") @db.Decimal(12, 0)
  totalAmount         Decimal?        @default(0) @map("total_amount") @db.Decimal(12, 0)
  guestName           String?         @map("guest_name") @db.VarChar(255)
  guestEmail          String?         @map("guest_email") @db.VarChar(255)
  guestPhone          String?         @map("guest_phone") @db.VarChar(20)
  guestIdNumber       String?         @map("guest_id_number") @db.VarChar(50)
  specialRequests     String?         @map("special_requests")
  internalNotes       String?         @map("internal_notes")
  source              String?         @default("WEBSITE") @db.VarChar(50)
  confirmedAt         DateTime?       @map("confirmed_at") @db.Timestamp(3)
  checkedInAt         DateTime?       @map("checked_in_at") @db.Timestamp(3)
  checkedOutAt        DateTime?       @map("checked_out_at") @db.Timestamp(3)
  cancelledAt         DateTime?       @map("cancelled_at") @db.Timestamp(3)
  cancellation_reason String?
  createdAt           DateTime?       @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt           DateTime?       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(3)

  user                User?           @relation(fields: [userId], references: [id])
  hotel               Hotel?          @relation(fields: [hotelId], references: [id])
  bookingRooms        BookingRoom[]
  payments            Payment[]

  @@index([bookingCode], map: "idx_bookings_code")
  @@index([checkIn, checkOut], map: "idx_bookings_dates")
  @@index([hotelId], map: "idx_bookings_hotel")
  @@index([status], map: "idx_bookings_status")
  @@index([userId], map: "idx_bookings_user")
  @@map("bookings")
}

/// Chi tiết phòng trong booking (multi-room support)
model BookingRoom {
  id            String    @id @default(cuid())
  bookingId     String    @map("booking_id") @db.VarChar(25)
  roomId        String    @map("room_id") @db.VarChar(25)
  checkIn       DateTime  @map("check_in") @db.Date
  checkOut      DateTime  @map("check_out") @db.Date
  pricePerNight Decimal   @map("price_per_night") @db.Decimal(12, 0)
  totalPrice    Decimal   @map("total_price") @db.Decimal(12, 0)
  created_at    DateTime? @default(now()) @db.Timestamp(3)
  updated_at    DateTime? @default(now()) @db.Timestamp(3)

  booking       Booking?  @relation(fields: [bookingId], references: [id])
  room          Room?     @relation(fields: [roomId], references: [id])

  @@index([bookingId], map: "idx_booking_rooms_booking")
  @@index([roomId], map: "idx_booking_rooms_room")
  @@map("booking_rooms")
}

/// Thanh toán
model Payment {
  id               String          @id @default(cuid())
  bookingId        String          @map("booking_id") @db.VarChar(25)
  amount           Decimal         @db.Decimal(12, 0)
  method           payment_method
  status           payment_status? @default(PENDING)
  transactionRef   String?         @map("transaction_ref") @db.VarChar(100)
  gateway_response Json?
  paidAt           DateTime?       @map("paid_at") @db.Timestamp(3)
  refundedAt       DateTime?       @map("refunded_at") @db.Timestamp(3)
  refundAmount     Decimal?        @map("refund_amount") @db.Decimal(12, 0)
  notes            String?
  createdAt        DateTime?       @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt        DateTime?       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(3)

  booking          Booking?        @relation(fields: [bookingId], references: [id])

  @@index([bookingId], map: "idx_payments_booking")
  @@index([status], map: "idx_payments_status")
  @@map("payments")
}

/// Đánh giá
model Review {
  id          String    @id @default(cuid())
  userId      String    @map("user_id") @db.VarChar(25)
  bookingId   String    @unique @map("booking_id") @db.VarChar(25)
  roomTypeId  String    @map("room_type_id") @db.VarChar(25)
  hotel_id    String    @db.VarChar(25)
  rating      Int
  title       String?   @db.VarChar(255)
  comment     String?
  pros        String?
  cons        String?
  response    String?
  response_at DateTime? @db.Timestamp(3)
  isVisible   Boolean?  @default(true) @map("is_visible")
  is_verified Boolean?  @default(false)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(3)

  user        User?     @relation(fields: [userId], references: [id])
  roomType    RoomType? @relation(fields: [roomTypeId], references: [id])
  hotel       Hotel?    @relation(fields: [hotel_id], references: [id])

  @@index([userId], map: "idx_reviews_user")
  @@map("reviews")
}

model audit_logs {
  id          String    @id @default(cuid())
  user_id     String?   @db.VarChar(25)
  action      String    @db.VarChar(100)
  entity_type String?   @db.VarChar(100)
  entity_id   String?   @db.VarChar(25)
  old_values  Json?
  new_values  Json?
  ip_address  String?   @db.VarChar(45)
  user_agent  String?
  created_at  DateTime? @default(now()) @db.Timestamp(3)

  @@index([created_at(sort: Desc)], map: "idx_audit_logs_created")
  @@index([entity_type, entity_id], map: "idx_audit_logs_entity")
  @@index([user_id], map: "idx_audit_logs_user")
}

model hotel_images {
  id         String    @id @default(cuid())
  hotel_id   String    @db.VarChar(25)
  url        String    @db.VarChar(500)
  alt_text   String?   @db.VarChar(255)
  sort_order Int?      @default(0)
  is_primary Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model refresh_tokens {
  id         String    @id @default(cuid())
  user_id    String    @db.VarChar(25)
  token      String    @unique @db.VarChar(500)
  expires_at DateTime  @db.Timestamp(3)
  created_at DateTime? @default(now()) @db.Timestamp(3)
  revoked_at DateTime? @db.Timestamp(3)

  @@index([expires_at], map: "idx_refresh_tokens_expires")
  @@index([user_id], map: "idx_refresh_tokens_user")
}

model room_type_images {
  id           String    @id @default(cuid())
  room_type_id String    @db.VarChar(25)
  url          String    @db.VarChar(500)
  alt_text     String?   @db.VarChar(255)
  sort_order   Int?      @default(0)
  is_primary   Boolean?  @default(false)
  created_at   DateTime? @default(now()) @db.Timestamp(6)

  roomType     RoomType? @relation(fields: [room_type_id], references: [id])
}

/// Tính năng tiện ích
model Amenity {
  id          String    @id @default(cuid())
  name        String    @unique @db.VarChar(255)
  description String?
  icon        String?   @db.VarChar(100)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  roomTypes   room_type_amenity[]

  @@map("amenities")
}

/// Junction table cho room type amenities
model room_type_amenity {
  id          String    @id @default(cuid())
  room_type_id String   @db.VarChar(25)
  amenity_id  String    @db.VarChar(25)
  created_at  DateTime? @default(now()) @db.Timestamp(6)

  roomType    RoomType? @relation(fields: [room_type_id], references: [id])
  amenity     Amenity?  @relation(fields: [amenity_id], references: [id])

  @@unique([room_type_id, amenity_id])
  @@map("room_type_amenities")
}

enum UserRole {
  SUPER_ADMIN
  HOTEL_ADMIN
  STAFF
  GUEST
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  OUT_OF_ORDER
}

enum AvailabilityStatus {
  AVAILABLE
  BOOKED
  BLOCKED
  MAINTENANCE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  MOMO
  VNPAY
  ZALOPAY
}

enum PricingType {
  BASE
  WEEKEND
  SEASONAL
  HOLIDAY
  PROMOTION
  LAST_MINUTE
}

enum BedType {
  SINGLE
  DOUBLE
  TWIN
  QUEEN
  KING
}

enum availability_status {
  AVAILABLE
  BOOKED
  BLOCKED
  MAINTENANCE
}

enum bed_type {
  SINGLE
  DOUBLE
  TWIN
  QUEEN
  KING
}

enum booking_status {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
  REFUNDED
}

enum payment_method {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  MOMO
  VNPAY
  ZALOPAY
}

enum payment_status {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum pricing_type {
  BASE
  WEEKEND
  SEASONAL
  HOLIDAY
  PROMOTION
  LAST_MINUTE
}

enum room_status {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  OUT_OF_ORDER
}

enum user_role {
  SUPER_ADMIN
  HOTEL_ADMIN
  STAFF
  GUEST
}
