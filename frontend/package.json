    "test:e2e:debug": "cd e2e && playwright test --debug",
    "test:e2e:headed": "cd e2e && playwright test --headed",
    "test:e2e:report": "cd e2e && playwright show-report"
  },
  "dependencies": {
    "@hookform/resolvers": "3.4.2",
    "axios": "1.7.2",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "jspdf": "^4.2.1",
    "lucide-react": "0.378.0",
    "next": "^16.2.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.51.5",
    "recharts": "^3.8.1",
    "tailwind-merge": "2.3.0",
    "zod": "3.23.8",
    "zustand": "4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.12.12",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^8.57.1",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "postcss": "8.4.38",
    "prettier": "3.2.5",
    "tailwindcss": "3.4.3",
    "ts-jest": "^29.4.9",
    "typescript": "5.4.5"
  }
