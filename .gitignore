# =============================================
# MONOREPO .gitignore
# =============================================

# ================== DEPENDENCIES ==================
node_modules/
.pnp
.pnp.js

# ================== BUILD OUTPUT ==================
# Backend
backend/dist/
backend/coverage/

# Frontend
frontend/.next/
frontend/out/
frontend/build/
frontend/coverage/

# ================== ENVIRONMENT ==================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Keep example files
!.env.example
!.env.*.example

# ================== LOGS ==================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ================== IDE ==================
# VSCode (keep settings, ignore personal)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains
.idea/
*.iml
*.iws

# ================== OS ==================
.DS_Store
Thumbs.db
Desktop.ini

# ================== TESTING ==================
coverage/
.nyc_output/
*.lcov

# ================== PRISMA ==================
# Generated client (regenerate with prisma generate)
# backend/node_modules/.prisma/

# ================== MISC ==================
*.tsbuildinfo
*.swp
*.swo
*~

# Temporary files
tmp/
temp/
.tmp/
.temp/
.cache/

# ================== LEGACY ==================
# WordPress archive - track but don't modify
# _legacy/ is tracked for reference

# Large files in legacy (optional - uncomment to ignore)
# _legacy/*.sql
# _legacy/wp-content/uploads/

# ================== DEBUG ==================
.eslintcache
.stylelintcache
